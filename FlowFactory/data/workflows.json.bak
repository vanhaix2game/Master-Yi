              "type": "run_script",
              "label": "Chay yeu cau"
            }
          ],
          "script": "#!/usr/bin/env python3\n# -*- coding: utf-8 -*-\nimport os, subprocess, sys\n\nOUT = r\"${OUT}\"\nos.makedirs(OUT, exist_ok=True)\n\ntask = \"\"\"{{task}}\"\"\"\nproject_dir = r\"{{project_dir}}\" or r\"D:\\Project\\LV\\MASTER\\pxhopencode\"\nmodel = r\"{{model}}\".strip()\n\ntask_file = os.path.join(OUT, \"_task.txt\")\ntry:\n    with open(task_file, \"w\", encoding=\"utf-8\") as f:\n        f.write(task)\nexcept OSError as exc:\n    print(\"ERR: khong ghi duoc task_file:\", exc)\n    sys.exit(1)\n\ncmd = [sys.executable, r\"D:\\\\Project\\\\LV\\\\MASTER\\\\FlowFactory\\\\opencode_bridge.py\",\n       \"--agent\", \"pxh-pm\", \"--task-file\", task_file,\n       \"--dir\", project_dir, \"--out\", OUT]\nif model:\n    cmd += [\"--model\", model]\n\nprint(\"Dang goi pxh-pm (opencode CLI)...\")\nproc = subprocess.run(cmd, capture_output=True, text=True,\n                      encoding=\"utf-8\", errors=\"replace\", timeout=1800)\nif proc.stdout:\n    print(proc.stdout, end=\"\")\nif proc.stderr:\n    sys.stderr.write(proc.stderr)\nsys.exit(proc.returncode)\n",
          "order": 1
        }
      ]
